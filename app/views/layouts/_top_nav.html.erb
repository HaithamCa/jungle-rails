<nav class="navbar navbar-default navbar-fixed-top modern-nav">
  <div class="container">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand" href="/">
        <strong>Jungle</strong>
      </a>
    </div>
    <div id="navbar" class="navbar-collapse collapse">
      <ul class="nav navbar-nav">
        <li>
          <%= link_to root_path do %>
            <%= fa_icon 'home' %> Home
          <% end %>
        </li>
        <li class="dropdown">
          <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
            <%= fa_icon 'th-large' %> Categories
            <span class="caret"></span>
          </a>
          <ul class="dropdown-menu">
            <% Category.all.each do |category| %>
              <li><%= link_to category.name, category %></li>
            <% end %>
          </ul>
        </li>
        <li>
          <%= link_to about_path do %>
            <%= fa_icon 'info-circle' %> About
          <% end %>
        </li>
        <% if current_user && current_user.admin? %>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
              <%= fa_icon 'shield' %> Admin
              <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to raw("#{fa_icon 'dashboard'} Dashboard"), [:admin, :root] %></li>
              <li><%= link_to raw("#{fa_icon 'cube'} Products"), [:admin, :products] %></li>
              <li><%= link_to raw("#{fa_icon 'folder'} Categories"), [:admin, :categories] %></li>
            </ul>
          </li>
        <% end %>
      </ul>
      <ul class="nav navbar-nav navbar-right">
        <li>
          <a href="#" id="theme-toggle" title="Toggle dark mode">
            <i class="fa fa-moon-o"></i>
          </a>
        </li>
        <li>
          <%= link_to cart_path do %>
            <%= fa_icon "shopping-cart" %> Cart (<%= cart.size %>)
          <% end %>
        </li>
        <% if current_user %>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
              <%= fa_icon 'user' %> <%= current_user.name %>
              <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to raw("#{fa_icon 'sign-out'} Logout"), '/logout' %></li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to raw("#{fa_icon 'sign-in'} Login"), '/login' %></li>
          <li><%= link_to raw("#{fa_icon 'user-plus'} Sign Up"), '/signup', class: 'btn-nav-signup' %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
